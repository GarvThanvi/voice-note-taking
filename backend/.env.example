# Database (PostgreSQL / Neon)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Server
PORT=8080
NODE_ENV=development

# Auth
JWT_SECRET="replace-with-a-long-random-string"
FRONTEND_URL="http://localhost:5173"

# OpenAI (Whisper transcription + intent extraction)
OPENAI_API_KEY="sk-..."

# Google OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:8080/api/auth/google/callback"

# Email (Brevo transactional API — password-reset emails)
BREVO_API_KEY=""
EMAIL_FROM_NAME="NoteFlow"
EMAIL_FROM_ADDRESS=""

# MCP connector
# Public origin of this backend, used in OAuth discovery documents and the
# token audience. Set it to the deployed URL in production.
MCP_PUBLIC_URL="http://localhost:8080"
# Shared secret between the API and its loopback-only /internal mount. Without
# it every MCP tool call fails.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MCP_INTERNAL_SECRET=""
# Optional per-minute rate limits (defaults shown).
# MCP_PREAUTH_LIMIT=600
# MCP_UNAUTH_LIMIT=20
# MCP_TOKEN_LIMIT=120
# OAUTH_REGISTER_LIMIT=10
# OAUTH_TOKEN_LIMIT=120
# OAUTH_PAGE_LIMIT=60

# Tests
# Neon test branch used by DB-backed tests. Must differ from DATABASE_URL;
# the test harness refuses to run otherwise.
TEST_DATABASE_URL=""
