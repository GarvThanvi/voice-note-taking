generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             Int      @id @default(autoincrement())
  email          String   @unique
  username       String
  password       String?
  googleId       String?  @unique
  profilePicture String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  notes          Note[]
  labels         Label[]
  passwordResetOtps PasswordResetOtp[]
  hasSeenGuide     Boolean  @default(false)
  showGuideOnLogin Boolean  @default(false)
  apiTokens        ApiToken[]
  oauthTokens      OauthToken[]
}

model Note {
  id         Int       @id @default(autoincrement())
  userId     Int
  type       NoteType  @default(PARAGRAPH)
  content    String
  archived   Boolean   @default(false)
  deletedAt  DateTime?
  bookmarked Boolean   @default(false)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  title      String?
  order      Float     @default(0)
  user       User      @relation(fields: [userId], references: [id])
  todos      Todo[]
  labels     Label[]

  @@index([userId, deletedAt, archived, updatedAt])
  @@index([userId, deletedAt, archived, order])
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin, map: "Note_title_trgm_idx")
}

model Todo {
  id        Int      @id @default(autoincrement())
  noteId    Int
  text      String
  done      Boolean  @default(false)
  order     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  note      Note     @relation(fields: [noteId], references: [id])

  @@index([noteId, order])
  @@index([text(ops: raw("gin_trgm_ops"))], type: Gin, map: "Todo_text_trgm_idx")
}

enum NoteType {
  CHECKBOX
  PARAGRAPH
}

model Label {
  id        Int      @id @default(autoincrement())
  userId    Int
  name      String
  color     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  notes     Note[]

  @@unique([userId, name])
  @@index([userId])
}

model NewsletterSubscriber {
  id             Int       @id @default(autoincrement())
  email          String    @unique
  subscribedAt   DateTime  @default(now())
  unsubscribedAt DateTime?
}

model PasswordResetOtp {
  id        Int      @id @default(autoincrement())
  userId    Int
  otpHash   String
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model ApiToken {
  id         Int       @id @default(autoincrement())
  userId     Int
  name       String
  tokenHash  String    @unique
  prefix     String
  scopes     String[]
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model OauthClient {
  id           String   @id
  name         String
  redirectUris String[]
  createdAt    DateTime @default(now())
  lastUsedAt   DateTime?
}

model OauthCode {
  id                  String   @id
  clientId            String
  userId              Int
  redirectUri         String
  scopes              String[]
  codeChallenge       String
  codeChallengeMethod String   @default("S256")
  resource            String?
  expiresAt           DateTime
  usedAt              DateTime?
  createdAt           DateTime @default(now())

  @@index([expiresAt])
}

model OauthToken {
  id               Int       @id @default(autoincrement())
  userId           Int
  clientId         String
  accessTokenHash  String    @unique
  refreshTokenHash String?   @unique
  scopes           String[]
  resource         String?
  accessExpiresAt  DateTime
  refreshExpiresAt DateTime?
  rotatedFromId    Int?
  // Every row in one rotation chain shares this value; a new pair owns its own
  // id as the family id. A replay revokes the whole family in one statement.
  familyId         String?
  revokedAt        DateTime?
  lastUsedAt       DateTime?
  createdAt        DateTime  @default(now())
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
}
